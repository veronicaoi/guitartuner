.program i2s_in
.side_set 2

.wrap_target
    nop                 side 0b00
    nop                 side 0b01
    set x, 29           side 0b00
left_loop:
    in pins, 1          side 0b01
    jmp x-- left_loop   side 0b00
    in pins, 1          side 0b01
    nop                 side 0b10
    in pins, 1          side 0b11
    set x, 29           side 0b10
right_loop:
    nop                 side 0b11
    jmp x-- right_loop  side 0b10
    nop                 side 0b11
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void i2s_in_program_init(PIO pio, uint sm, uint offset,
                                       uint sck_pin, uint sd_pin,
                                       float sample_rate_hz) {
    pio_gpio_init(pio, sck_pin);
    pio_gpio_init(pio, sck_pin + 1);   // WS = SCK + 1
    pio_gpio_init(pio, sd_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, sck_pin, 2, true);
    pio_sm_set_consecutive_pindirs(pio, sm, sd_pin, 1, false);

    pio_sm_config c = i2s_in_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, sck_pin);
    sm_config_set_in_pins(&c, sd_pin);
    sm_config_set_in_shift(&c, false, true, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / (sample_rate_hz * 128.0f));

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}